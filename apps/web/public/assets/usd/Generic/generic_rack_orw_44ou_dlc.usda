#usda 1.0
(
    "Generic Wide OU rack, 44 OU — Wide OU rack liquid-cooled rack-scale configuration: 18 x 1 OU compute, 9 x 1 OU scale-up switch, 8 x 1 OU power shelves, 2 x 1 OU management. Parametric asset generated by AIDC Studio tools/asset-pipeline/generic_usd.py from tools/asset-pipeline/generic_spec.json. Not a model of any vendor product; no logos or lettering."
    defaultPrim = "GenericRack"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "GenericRack" (
    kind = "component"
)
{
    custom string aidc:assetClass = "Compute Rack" (
        doc = "Generic equipment class"
    )
    custom string aidc:assetVersion = "1.0.0" (
        doc = "Asset revision"
    )
    custom float aidc:busbarDatumMm = 802.59 (
        doc = "Datum to IT busbar depth [standard (datum A to +48 V busbar 802.59 mm, ORW 1.0.0 drawings; frame busbar interfaces identical to the high-power 21-inch rack busbar interface, ORW Base 1.0.0 section 4.3); datum placed at the front vertical (faceplate) plane - estimate; busbar width and depth estimate (overall busbar depth is not defined by the base specification)]"
    )
    custom string aidc:colorSpace = "linear" (
        doc = "diffuseColor / emissiveColor are linear (sRGB hex in generic_spec.json palette)"
    )
    custom string aidc:description = "Generic wide OU rack, 44 OU (1200 x 1219 mm), liquid-cooled rack-scale configuration: 18 compute / 9 switch / 8 power trays, busbar at the datum depth, rear manifold, forklift base" (
        doc = "Description"
    )
    custom float3 aidc:dimsMm = (1200, 1219, 2390) (
        doc = "W x D x H in mm (catalog-sized body)"
    )
    custom string aidc:formFactor = "orw-wide-44ou" (
        doc = "Wide OU rack, 44 OU"
    )
    custom string aidc:generator = "tools/asset-pipeline/generic_usd.py" (
        doc = "AIDC Studio generator"
    )
    custom float aidc:hacSealPlaneMm = 1068 (
        doc = "standard (default hot-aisle containment seal plane 42 in = 1068 mm from the front face, ORW Meta Design 1.0.0)"
    )
    custom float aidc:itShelfKgPerSet = 125 (
        doc = "standard (ORW Meta Design 1.0.0: payload 4700 kg minimum with allowable bracing, excluding the frame; 125 kg per IT support shelf set, dynamic)"
    )
    custom string aidc:layout = "rackscale-dlc-orw-44ou" (
        doc = "Wide OU rack liquid-cooled rack-scale configuration: 18 x 1 OU compute, 9 x 1 OU scale-up switch, 8 x 1 OU power shelves, 2 x 1 OU management"
    )
    custom string aidc:licence = "MIT (AIDC Studio original)" (
        doc = "Licence of this generated asset"
    )
    custom int aidc:lod = 0 (
        doc = "0 = full detail, 1 = explicit low detail"
    )
    custom string aidc:manufacturer = "generic" (
        doc = "Not a model of any vendor product"
    )
    custom string aidc:modelName = "generic_rack_orw_44ou_dlc" (
        doc = "Generic model name (form factor / size keyed)"
    )
    custom string aidc:nativeFront = "+X" (
        doc = "Front axis (usd_to_glb maps it to glTF -Z)"
    )
    custom float aidc:panelWidthMm = 1094.44 (
        doc = "Equipment faceplate width [standard (inner verticals 1094.44 mm, ORW Meta Design 1.0.0 drawings); faceplates are drawn to fill the opening]"
    )
    custom float aidc:payloadKg = 4700 (
        doc = "standard (ORW Meta Design 1.0.0: payload 4700 kg minimum with allowable bracing, excluding the frame; 125 kg per IT support shelf set, dynamic)"
    )
    custom string aidc:sourceTag = "form factor: standard (ORW Base 1.0.0: OpenU 48.00 mm; 44 OU / 47 RU / 88 half-OU); frame: standard (ORW Meta Design 1.0.0: nominal 2390 x 1200 x 1219 mm; drawing values 2389.9 / 1200.24 / 1219.24 mm); layout: estimate (generic 72-accelerator rack-scale configuration of this spec: same tray counts as rackscale-dlc-48u-72acc, positions chosen for the 44 OU wide frame; not a vendor tray layout)" (
        doc = "Provenance summary"
    )
    custom string aidc:specFile = "tools/asset-pipeline/generic_spec.json" (
        doc = "Parameter source"
    )
    custom string aidc:standards = "orw-base@1.0.0; orw-meta-design@1.0.0" (
        doc = "Pinned standard documents the form-factor values come from (see generic_spec.json sources)"
    )
    custom int aidc:triangles = 16956 (
        doc = "Authored triangle count"
    )
    custom float aidc:unitPitchMm = 48 (
        doc = "OU pitch in mm [standard (ORW Base 1.0.0: OpenU 48.00 mm; 44 OU / 47 RU / 88 half-OU)]"
    )
    custom int aidc:units = 44 (
