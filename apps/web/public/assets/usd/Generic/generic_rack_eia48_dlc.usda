    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "GenericRack" (
    kind = "component"
)
{
    custom string aidc:assetClass = "Compute Rack" (
        doc = "Generic equipment class"
    )
    custom string aidc:assetVersion = "1.0.0" (
        doc = "Asset revision"
    )
    custom string aidc:colorSpace = "linear" (
        doc = "diffuseColor / emissiveColor are linear (sRGB hex in generic_spec.json palette)"
    )
